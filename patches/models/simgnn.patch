+def _spearman_correlation(left, right):
+    if len(left) != len(right) or len(left) < 2:
+        return 0.0
+    left_ranks = _average_ranks(left)
+    right_ranks = _average_ranks(right)
+    left_mean = np.mean(left_ranks)
+    right_mean = np.mean(right_ranks)
+    numerator = np.sum(
+        (left_ranks - left_mean) * (right_ranks - right_mean)
+    )
+    denominator = np.sqrt(
+        np.sum((left_ranks - left_mean) ** 2)
+        * np.sum((right_ranks - right_mean) ** 2)
+    )
+    return float(numerator / denominator) if denominator > 0 else 0.0
+
+
+def _average_ranks(values):
+    ordered = sorted(enumerate(values), key=lambda item: (float(item[1]), item[0]))
+    ranks = np.zeros(len(values), dtype=float)
+    cursor = 0
+    while cursor < len(ordered):
+        end = cursor + 1
+        while end < len(ordered) and float(ordered[end][1]) == float(ordered[cursor][1]):
+            end += 1
+        average_rank = (cursor + 1 + end) / 2.0
+        for position in range(cursor, end):
+            ranks[ordered[position][0]] = average_rank
+        cursor = end
+    return ranks
